{
  "name": "lba-restaurant-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Simulador profesional de operaciones de restaurante: editor 2D + motor de simulación determinista de eventos discretos. Open source (MIT).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lean031110/LBA_Restaurant_Engine.git"
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.9",
    "typescript-eslint": "8.71.1"
  },
  "scripts": {
    "dev": "npm run dev --workspace @lba/web",
    "build": "npm run build --workspaces --if-present",
    "preview": "npm run preview --workspace @lba/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspace @lba/web",
    "audit:licenses": "node scripts/audit-licenses.mjs",
    "audit:security": "npm audit --audit-level=high"
  }
}
